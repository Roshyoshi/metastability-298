.save v(p_b) v(p_allow_count) v(p_tick_n) v(p_run) v(p_n0) v(p_n1) v(p_n2) v(p_n3)
.control
set filetype=binary
set num_threads=1
tran 10p 1600n
let first_cap=-1
meas tran first_cap when v(uio_out_4)=1.65 rise=1
if first_cap < 0
echo RESULT post_b2_early first_capture_ns not_measured
else
let r=first_cap*1e9
echo RESULT post_b2_early first_capture_ns $&r
end
let d1=-1
meas tran d1 trig v(uio_out_4) val=1.65 rise=1 targ v(uio_out_5) val=1.65 rise=1
if d1 < 0
echo RESULT post_b2_early monitor_delay_ps_trial1 not_measured
else
let r=d1*1e12
echo RESULT post_b2_early monitor_delay_ps_trial1 $&r
end
let d2=-1
meas tran d2 trig v(uio_out_4) val=1.65 rise=2 targ v(uio_out_5) val=1.65 rise=2
if d2 < 0
echo RESULT post_b2_early monitor_delay_ps_trial2 not_measured
else
let r=d2*1e12
echo RESULT post_b2_early monitor_delay_ps_trial2 $&r
end
let d3=-1
meas tran d3 trig v(uio_out_4) val=1.65 rise=3 targ v(uio_out_5) val=1.65 rise=3
if d3 < 0
echo RESULT post_b2_early monitor_delay_ps_trial3 not_measured
else
let r=d3*1e12
echo RESULT post_b2_early monitor_delay_ps_trial3 $&r
end
meas tran busy find v(uio_out_1) at=1590n
echo RESULT post_b2_early busy_V $&busy
meas tran done find v(uio_out_2) at=1590n
echo RESULT post_b2_early done_V $&done
meas tran fault find v(uio_out_3) at=1590n
echo RESULT post_b2_early fault_V $&fault
meas tran ev0 find v(uo_out_0) at=1590n
meas tran ev1 find v(uo_out_1) at=1590n
meas tran ev2 find v(uo_out_2) at=1590n
meas tran ev3 find v(uo_out_3) at=1590n
meas tran ev4 find v(uo_out_4) at=1590n
meas tran ev5 find v(uo_out_5) at=1590n
meas tran ev6 find v(uo_out_6) at=1590n
meas tran ev7 find v(uo_out_7) at=1590n
let ev=1*(ev0 gt 1.65)+2*(ev1 gt 1.65)+4*(ev2 gt 1.65)+8*(ev3 gt 1.65)+16*(ev4 gt 1.65)+32*(ev5 gt 1.65)+64*(ev6 gt 1.65)+128*(ev7 gt 1.65)
echo RESULT post_b2_early events $&ev
let d_trial1=-1
meas tran d_trial1 trig v(p_capture_local) val=1.65 rise=1 td=100n targ v(p_early_clk) val=1.65 rise=1 td=100n
if d_trial1 < 0
echo RESULT post_b2_early d_trial1_ps not_measured
else
let r=d_trial1*1e12
echo RESULT post_b2_early d_trial1_ps $&r
end
let d_trial2=-1
meas tran d_trial2 trig v(p_capture_local) val=1.65 rise=1 td=300n targ v(p_early_clk) val=1.65 rise=1 td=300n
if d_trial2 < 0
echo RESULT post_b2_early d_trial2_ps not_measured
else
let r=d_trial2*1e12
echo RESULT post_b2_early d_trial2_ps $&r
end
let d_trial3=-1
meas tran d_trial3 trig v(p_capture_local) val=1.65 rise=1 td=500n targ v(p_early_clk) val=1.65 rise=1 td=500n
if d_trial3 < 0
echo RESULT post_b2_early d_trial3_ps not_measured
else
let r=d_trial3*1e12
echo RESULT post_b2_early d_trial3_ps $&r
end
let bank_cap_after_capture_local_trial1=-1
meas tran bank_cap_after_capture_local_trial1 trig v(p_capture_local) val=1.65 rise=1 td=100n targ v(p_bank_cap) val=1.65 rise=1 td=100n
if bank_cap_after_capture_local_trial1 < 0
echo RESULT post_b2_early bank_cap_after_capture_local_trial1_ps not_measured
else
let r=bank_cap_after_capture_local_trial1*1e12
echo RESULT post_b2_early bank_cap_after_capture_local_trial1_ps $&r
end
let bank_cap_after_capture_local_trial2=-1
meas tran bank_cap_after_capture_local_trial2 trig v(p_capture_local) val=1.65 rise=1 td=300n targ v(p_bank_cap) val=1.65 rise=1 td=300n
if bank_cap_after_capture_local_trial2 < 0
echo RESULT post_b2_early bank_cap_after_capture_local_trial2_ps not_measured
else
let r=bank_cap_after_capture_local_trial2*1e12
echo RESULT post_b2_early bank_cap_after_capture_local_trial2_ps $&r
end
let bank_cap_after_capture_local_trial3=-1
meas tran bank_cap_after_capture_local_trial3 trig v(p_capture_local) val=1.65 rise=1 td=500n targ v(p_bank_cap) val=1.65 rise=1 td=500n
if bank_cap_after_capture_local_trial3 < 0
echo RESULT post_b2_early bank_cap_after_capture_local_trial3_ps not_measured
else
let r=bank_cap_after_capture_local_trial3*1e12
echo RESULT post_b2_early bank_cap_after_capture_local_trial3_ps $&r
end
let bank_q_arrives_falling=-1
meas tran bank_q_arrives_falling trig v(p_bank_cap) val=1.65 rise=1 td=300n targ v(p_bank_selected_q) val=1.65 fall=1 td=300n
if bank_q_arrives_falling < 0
echo RESULT post_b2_early bank_q_arrives_falling_ps not_measured
else
let r=bank_q_arrives_falling*1e12
echo RESULT post_b2_early bank_q_arrives_falling_ps $&r
end
let bank_q_arrives_rising=-1
meas tran bank_q_arrives_rising trig v(p_bank_cap) val=1.65 rise=1 td=500n targ v(p_bank_selected_q) val=1.65 rise=1 td=500n
if bank_q_arrives_rising < 0
echo RESULT post_b2_early bank_q_arrives_rising_ps not_measured
else
let r=bank_q_arrives_rising*1e12
echo RESULT post_b2_early bank_q_arrives_rising_ps $&r
end
let bank_obs_clk_after_bank_cap_trial2=-1
meas tran bank_obs_clk_after_bank_cap_trial2 trig v(p_bank_cap) val=1.65 rise=1 td=300n targ v(p_bank_obs_clk) val=1.65 rise=1 td=300n
if bank_obs_clk_after_bank_cap_trial2 < 0
echo RESULT post_b2_early bank_obs_clk_after_bank_cap_trial2_ps not_measured
else
let r=bank_obs_clk_after_bank_cap_trial2*1e12
echo RESULT post_b2_early bank_obs_clk_after_bank_cap_trial2_ps $&r
end
let run_edge=-1
meas tran run_edge trig v(p_run) val=0.33 rise=1 targ v(p_run) val=2.97 rise=1
if run_edge < 0
echo RESULT post_b2_early run_edge_10_90_ps not_measured
else
let r=run_edge*1e12
echo RESULT post_b2_early run_edge_10_90_ps $&r
end
meas tran tick_min min v(p_tick_n) from=700n to=900n
echo RESULT post_b2_early tick_n_min_V_before_first_count $&tick_min
let b_fall_to_allow_count=-1
meas tran b_fall_to_allow_count trig v(p_b) val=1.65 fall=1 td=800n targ v(p_allow_count) val=1.65 rise=1
if b_fall_to_allow_count < 0
echo RESULT post_b2_early b_fall_to_allow_count_ps not_measured
else
let r=b_fall_to_allow_count*1e12
echo RESULT post_b2_early b_fall_to_allow_count_ps $&r
end
let b_rise_to_tick_n_fall=-1
meas tran b_rise_to_tick_n_fall trig v(p_b) val=1.65 rise=1 td=900n targ v(p_tick_n) val=1.65 fall=1
if b_rise_to_tick_n_fall < 0
echo RESULT post_b2_early b_rise_to_tick_n_fall_ps not_measured
else
let r=b_rise_to_tick_n_fall*1e12
echo RESULT post_b2_early b_rise_to_tick_n_fall_ps $&r
end
let tick_w=-1
meas tran tick_w trig v(p_tick_n) val=1.65 fall=1 targ v(p_tick_n) val=1.65 rise=1
if tick_w < 0
echo RESULT post_b2_early count_pulse_width_ns not_measured
else
let r=tick_w*1e9
echo RESULT post_b2_early count_pulse_width_ns $&r
end
let tick_n_to_n0=-1
meas tran tick_n_to_n0 trig v(p_tick_n) val=1.65 fall=1 targ v(p_n0) val=1.65 rise=1
if tick_n_to_n0 < 0
echo RESULT post_b2_early tick_n_to_n0_ps not_measured
else
let r=tick_n_to_n0*1e12
echo RESULT post_b2_early tick_n_to_n0_ps $&r
end
let n0_to_n1_through_inverter=-1
meas tran n0_to_n1_through_inverter trig v(p_n0) val=1.65 rise=1 targ v(p_n1) val=1.65 rise=1
if n0_to_n1_through_inverter < 0
echo RESULT post_b2_early n0_to_n1_through_inverter_ps not_measured
else
let r=n0_to_n1_through_inverter*1e12
echo RESULT post_b2_early n0_to_n1_through_inverter_ps $&r
end
let stage_n1_fall_to_n2_rise=-1
meas tran stage_n1_fall_to_n2_rise trig v(p_n1) val=1.65 fall=1 targ v(p_n2) val=1.65 rise=1
if stage_n1_fall_to_n2_rise < 0
echo RESULT post_b2_early stage_n1_fall_to_n2_rise_ps not_measured
else
let r=stage_n1_fall_to_n2_rise*1e12
echo RESULT post_b2_early stage_n1_fall_to_n2_rise_ps $&r
end
write isup_b2.raw
.endc
.end
