** sch_path: ~/metastability-298/build/sims/kit/benches/tb_delay.sch
**.subckt tb_delay
vvdd VDD GND 3.3
vcap capture GND PWL(0 0 1n 0 1.05n 3.3 2n 3.3 2.05n 0 5n 0 5.05n 3.3)
vbias ua_0 GND 3.0
xcapd capture capture_local capture_drivers
xdelay capture_local ua_0 early_clk delay
xearly early_clk 0 early_q early_observer
**** begin user architecture code

.include ~/.ciel/ciel/gf180mcu/versions/e8daeda73ca8f5814dbc0b11d1d05802251a3750/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib ~/.ciel/ciel/gf180mcu/versions/e8daeda73ca8f5814dbc0b11d1d05802251a3750/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib ~/.ciel/ciel/gf180mcu/versions/e8daeda73ca8f5814dbc0b11d1d05802251a3750/gf180mcuD/libs.tech/ngspice/sm141064.ngspice diode_typical
.global VDD
.param sw_stat_global=0 sw_stat_mismatch=0
* ideal-capacitor reference copy of the delay line
xri0 capture_local isob_r inv_1
xri1 isob_r iso_r inv_2
xmp_r slow_r iso_r VDD VDD pfet_05v0 w=1.22u l=0.5u ad=6.1e-13 as=6.1e-13 pd=3.44e-06 ps=3.44e-06
xmn_r slow_r iso_r foot_r 0 nfet_05v0 w=0.82u l=0.6u ad=4.1e-13 as=4.1e-13 pd=2.64e-06 ps=2.64e-06
xmc_r foot_r ua_0 0 0 nfet_05v0 w=0.36u l=0.6u ad=1.8e-13 as=1.8e-13 pd=1.72e-06 ps=1.72e-06
cct_r slow_r 0 2f
xrr0 slow_r r0_r inv_1
xrr1 r0_r r1_r inv_2
xrr2 r1_r early_r inv_2
xer 0 early_r q_r dffq_1
.control
set filetype=ascii
foreach vb 1.1 1.3 1.5 1.8 2.4 3.0
 alter vbias $vb
 tran 5p 14n
 meas tran dly trig v(capture_local) val=1.65 td=4n rise=1 targ v(early_clk) val=1.65 td=4n rise=1
 meas tran dlr trig v(capture_local) val=1.65 td=4n rise=1 targ v(early_r) val=1.65 td=4n rise=1
 let dns=dly*1e9
 let dnr=dlr*1e9
 echo RESULT d_ns_at_ua0 $vb $&dns
 echo RESULT d_ideal_ns_at_ua0 $vb $&dnr
end
.endc

**** end user architecture code
