** sch_path: ~/ece298a/round2/benches/tb_controller.sch
**.subckt tb_controller
vvdd VDD GND 3.3
vclk clk GND PULSE(0 3.3 24.5n 0.1n 0.1n 24.9n 50n)
vrst rst_n GND PWL(0 0 60n 0 60.1n 3.3)
vstart ui_in_4 GND PWL(0 0 210n 0 210.1n 3.3 510n 3.3 510.1n 0)
vena ena GND 3.3
vs0 ui_in_3 GND 3.3
vs1 uio_in_6 GND 0
vdq selected_q GND 3.3
vea early_q GND 0
xctrl clk early_q ena rst_n selected_q ui_in_3 ui_in_4 uio_in_6 capture cfg_0 cfg_1 uio_out_1
+ uio_out_2 uio_out_3 uo_out_0 uo_out_1 uo_out_2 uo_out_3 uo_out_4 uo_out_5 uo_out_6 uo_out_7 controller
**** begin user architecture code

.include /usr/local/share/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /usr/local/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /usr/local/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice diode_typical
.global VDD
.param sw_stat_global=0 sw_stat_mismatch=0
.control
set filetype=ascii
tran 50p 2.5u
meas tran first_cap when v(capture)=1.65 rise=1
let a=first_cap*1e9
echo RESULT first_capture_ns $&a
meas tran b0 find v(uo_out_0) at=2.49u
meas tran b1 find v(uo_out_1) at=2.49u
meas tran b2 find v(uo_out_2) at=2.49u
meas tran b3 find v(uo_out_3) at=2.49u
meas tran b4 find v(uo_out_4) at=2.49u
meas tran b5 find v(uo_out_5) at=2.49u
meas tran b6 find v(uo_out_6) at=2.49u
meas tran b7 find v(uo_out_7) at=2.49u
let ev=(b0 gt 1.65)+2*(b1 gt 1.65)+4*(b2 gt 1.65)+8*(b3 gt 1.65)+16*(b4 gt 1.65)+32*(b5 gt
+ 1.65)+64*(b6 gt 1.65)+128*(b7 gt 1.65)
echo RESULT events_after_6_trials $&ev
meas tran busy find v(uio_out_1) at=2.49u
meas tran done find v(uio_out_2) at=2.49u
meas tran fault find v(uio_out_3) at=2.49u
echo RESULT busy_V $&busy
echo RESULT done_V $&done
echo RESULT fault_V $&fault
wrdata tb_controller.dat v(clk) v(capture) v(uio_out_1) v(uo_out_0) v(uo_out_1) v(uo_out_2)
+ v(uo_out_3) v(uo_out_4) v(uo_out_5) v(uo_out_6) v(uo_out_7)
.endc

**** end user architecture code
**.ends

