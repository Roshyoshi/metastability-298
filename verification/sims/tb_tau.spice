** sch_path: ~/metastability-298/build/sims/kit/benches/tb_tau.sch
**.subckt tb_tau
vvdd VDD GND 3.3
xbaseline0 0 VDD qbaseline0 meta_dut_baseline
xobaseline0 qbaseline0 qobaseline0 inv_1
cqbaseline0 qbaseline0 0 2f m=1
xbaseline1 0 VDD qbaseline1 meta_dut_baseline
xobaseline1 qbaseline1 qobaseline1 inv_1
cqbaseline1 qbaseline1 0 2f m=1
xkeeper0 0 VDD qkeeper0 meta_dut_keeper
xokeeper0 qkeeper0 qokeeper0 inv_1
cqkeeper0 qkeeper0 0 2f m=1
xkeeper1 0 VDD qkeeper1 meta_dut_keeper
xokeeper1 qkeeper1 qokeeper1 inv_1
cqkeeper1 qkeeper1 0 2f m=1
xforward0 0 VDD qforward0 meta_dut_forward
xoforward0 qforward0 qoforward0 inv_1
cqforward0 qforward0 0 2f m=1
xforward1 0 VDD qforward1 meta_dut_forward
xoforward1 qforward1 qoforward1 inv_1
cqforward1 qforward1 0 2f m=1
**** begin user architecture code

.include ~/.ciel/ciel/gf180mcu/versions/e8daeda73ca8f5814dbc0b11d1d05802251a3750/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib ~/.ciel/ciel/gf180mcu/versions/e8daeda73ca8f5814dbc0b11d1d05802251a3750/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib ~/.ciel/ciel/gf180mcu/versions/e8daeda73ca8f5814dbc0b11d1d05802251a3750/gf180mcuD/libs.tech/ngspice/sm141064.ngspice diode_typical
.global VDD
.param sw_stat_global=0 sw_stat_mismatch=0
.options method=gear reltol=1e-6 abstol=1e-12 vntol=1e-12 chgtol=1e-14 trtol=1
.ic v(xbaseline0.mq)=1.442642 v(xbaseline0.mqb)=1.441642 v(xbaseline1.mq)=1.442147
+ v(xbaseline1.mqb)=1.442137 v(xkeeper0.mq)=1.442642 v(xkeeper0.mqb)=1.441642 v(xkeeper1.mq)=1.442147 v(xkeeper1.mqb)=1.442137
+ v(xforward0.mq)=1.442642 v(xforward0.mqb)=1.441642 v(xforward1.mq)=1.442147 v(xforward1.mqb)=1.442137
.control
set filetype=ascii
tran 1p 3n
meas tran t_baseline0 when v(xbaseline0.mq)=2.5 cross=1
meas tran t_baseline1 when v(xbaseline1.mq)=2.5 cross=1
meas tran t_keeper0 when v(xkeeper0.mq)=2.5 cross=1
meas tran t_keeper1 when v(xkeeper1.mq)=2.5 cross=1
meas tran t_forward0 when v(xforward0.mq)=2.5 cross=1
meas tran t_forward1 when v(xforward1.mq)=2.5 cross=1
let tau_baseline=(t_baseline1-t_baseline0)/ln(100)*1e12
echo RESULT tau_base_ps $&tau_baseline
let tau_keeper=(t_keeper1-t_keeper0)/ln(100)*1e12
echo RESULT tau_keeper_ps $&tau_keeper
let tau_forward=(t_forward1-t_forward0)/ln(100)*1e12
echo RESULT tau_forward_ps $&tau_forward
wrdata tb_tau.dat v(xbaseline1.mq) v(xbaseline1.mqb) v(xkeeper1.mq) v(xkeeper1.mqb) v(xforward1.mq)
+ v(xforward1.mqb)
.endc

