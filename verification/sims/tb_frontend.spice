** sch_path: ~/ece298a/round2/benches/tb_frontend.sch
**.subckt tb_frontend
vvdd VDD GND 3.3
vcap capture GND PWL(0 0 1n 0 1.05n 3.3 2n 3.3 2.05n 0 5n 0 5.05n 3.3)
vd ui_in_6 GND PWL(0 0 2.975n 0 3.025n 3.3)
vs0 cfg_0 GND 3.3
vs1 cfg_1 GND 0
vbias ua_0 GND 3.0
xdata_input ui_in_6 data_local data_input
xcapture_drivers capture capture_local capture_drivers
xduts capture_local data_local q_0 q_1 q_2 q_3 duts
xselector cfg_0 cfg_1 q_0 q_1 q_2 q_3 selected_q selector
xdelay capture_local ua_0 early_clk delay
xearly_observer early_clk selected_q early_q early_observer
xmonitors capture_local early_clk uio_out_4 uio_out_5 monitors
**** begin user architecture code

.include /usr/local/share/pdk/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /usr/local/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /usr/local/share/pdk/gf180mcuD/libs.tech/ngspice/sm141064.ngspice diode_typical
.global VDD
.param sw_stat_global=0 sw_stat_mismatch=0
.control
set filetype=ascii
tran 2p 14n
meas tran d_short trig v(capture_local) val=1.65 td=4n rise=1 targ v(early_clk) val=1.65 td=4n
+ rise=1
meas tran arrive trig v(capture_local) val=1.65 td=4n rise=1 targ v(selected_q) val=1.65 td=4n
+ rise=1
meas tran early_short find v(early_q) at=13.9n
meas tran final_short find v(selected_q) at=13.9n
wrdata tb_frontend_short.dat v(capture_local) v(selected_q) v(early_clk) v(early_q)
let a=d_short*1e12
echo RESULT d_short_ps $&a
let a=arrive*1e12
echo RESULT arrive_ps $&a
echo RESULT early_short_V $&early_short
echo RESULT final_short_V $&final_short
alter vbias 1.41171875
tran 2p 14n
meas tran d_allowed trig v(capture_local) val=1.65 td=4n rise=1 targ v(early_clk) val=1.65 td=4n
+ rise=1
meas tran early_allowed find v(early_q) at=13.9n
meas tran final_allowed find v(selected_q) at=13.9n
wrdata tb_frontend_allowed.dat v(capture_local) v(selected_q) v(early_clk) v(early_q)
let a=d_allowed*1e12
echo RESULT d_allowed_ps $&a
echo RESULT early_allowed_V $&early_allowed
echo RESULT final_allowed_V $&final_allowed
.endc

**** end user architecture code
**.ends

