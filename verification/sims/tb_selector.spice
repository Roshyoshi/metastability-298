** sch_path: ~/ece298a/round2/blocks/selector.sch
.subckt selector cfg_0 cfg_1 q_0 q_1 q_2 q_3 selected_q
*.ipin cfg_0
*.ipin cfg_1
*.ipin q_0
*.ipin q_1
*.ipin q_2
*.ipin q_3
*.opin selected_q
xselect_dut q_0 q_1 q_2 q_3 cfg_0 cfg_1 selected_q mux4_1
.ends


