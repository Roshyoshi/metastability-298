** sch_path: ~/metastability-298/build/sims/kit/benches/tb_duts.sch
**.subckt tb_duts
vvdd VDD GND 3.3
vcap capture GND PWL(0 0 1n 0 1.05n 3.3 2n 3.3 2.05n 0 5n 0 5.05n 3.3)
vd ui_in_6 GND PWL(0 0 2.975n 0 3.025n 3.3)
xdata ui_in_6 data_local data_input
xcapd capture capture_local capture_drivers
xduts capture_local data_local q_0 q_1 q_2 q_3 duts
cl0 q_0 0 2f m=1
cl1 q_1 0 2f m=1
cl2 q_2 0 2f m=1
cl3 q_3 0 2f m=1
**** begin user architecture code

.include ~/.ciel/ciel/gf180mcu/versions/e8daeda73ca8f5814dbc0b11d1d05802251a3750/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib ~/.ciel/ciel/gf180mcu/versions/e8daeda73ca8f5814dbc0b11d1d05802251a3750/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib ~/.ciel/ciel/gf180mcu/versions/e8daeda73ca8f5814dbc0b11d1d05802251a3750/gf180mcuD/libs.tech/ngspice/sm141064.ngspice diode_typical
.global VDD
.param sw_stat_global=0 sw_stat_mismatch=0
.control
set filetype=ascii
tran 1p 8n
meas tran tcq0 trig v(capture_local) val=1.65 td=4n rise=1 targ v(q_0) val=1.65 td=4n rise=1
let tcq0ps=tcq0*1e12
echo RESULT tcq_lib_ps $&tcq0ps
meas tran tcq1 trig v(capture_local) val=1.65 td=4n rise=1 targ v(q_1) val=1.65 td=4n rise=1
let tcq1ps=tcq1*1e12
echo RESULT tcq_base_ps $&tcq1ps
meas tran tcq2 trig v(capture_local) val=1.65 td=4n rise=1 targ v(q_2) val=1.65 td=4n rise=1
let tcq2ps=tcq2*1e12
echo RESULT tcq_keeper_ps $&tcq2ps
meas tran tcq3 trig v(capture_local) val=1.65 td=4n rise=1 targ v(q_3) val=1.65 td=4n rise=1
let tcq3ps=tcq3*1e12
echo RESULT tcq_forward_ps $&tcq3ps
wrdata tb_duts.dat v(capture_local) v(data_local) v(q_0) v(q_1) v(q_2) v(q_3)
.endc

**** end user architecture code
**.ends

