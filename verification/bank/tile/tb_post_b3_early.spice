echo RESULT post_b3_early bank_cap_after_capture_local_trial3_ps not_measured
else
let r=bank_cap_after_capture_local_trial3*1e12
echo RESULT post_b3_early bank_cap_after_capture_local_trial3_ps $&r
end
let bank_q_arrives_falling=-1
meas tran bank_q_arrives_falling trig v(p_bank_cap) val=1.65 rise=1 td=300n targ v(p_bank_selected_q) val=1.65 fall=1 td=300n
if bank_q_arrives_falling < 0
echo RESULT post_b3_early bank_q_arrives_falling_ps not_measured
else
let r=bank_q_arrives_falling*1e12
echo RESULT post_b3_early bank_q_arrives_falling_ps $&r
end
let bank_q_arrives_rising=-1
meas tran bank_q_arrives_rising trig v(p_bank_cap) val=1.65 rise=1 td=500n targ v(p_bank_selected_q) val=1.65 rise=1 td=500n
if bank_q_arrives_rising < 0
echo RESULT post_b3_early bank_q_arrives_rising_ps not_measured
else
let r=bank_q_arrives_rising*1e12
echo RESULT post_b3_early bank_q_arrives_rising_ps $&r
end
let bank_obs_clk_after_bank_cap_trial2=-1
meas tran bank_obs_clk_after_bank_cap_trial2 trig v(p_bank_cap) val=1.65 rise=1 td=300n targ v(p_bank_obs_clk) val=1.65 rise=1 td=300n
if bank_obs_clk_after_bank_cap_trial2 < 0
echo RESULT post_b3_early bank_obs_clk_after_bank_cap_trial2_ps not_measured
else
let r=bank_obs_clk_after_bank_cap_trial2*1e12
echo RESULT post_b3_early bank_obs_clk_after_bank_cap_trial2_ps $&r
end
let run_edge=-1
meas tran run_edge trig v(p_run) val=0.33 rise=1 targ v(p_run) val=2.97 rise=1
if run_edge < 0
echo RESULT post_b3_early run_edge_10_90_ps not_measured
else
let r=run_edge*1e12
echo RESULT post_b3_early run_edge_10_90_ps $&r
end
meas tran tick_min min v(p_tick_n) from=700n to=900n
echo RESULT post_b3_early tick_n_min_V_before_first_count $&tick_min
let b_fall_to_allow_count=-1
meas tran b_fall_to_allow_count trig v(p_b) val=1.65 fall=1 td=800n targ v(p_allow_count) val=1.65 rise=1
if b_fall_to_allow_count < 0
echo RESULT post_b3_early b_fall_to_allow_count_ps not_measured
else
let r=b_fall_to_allow_count*1e12
echo RESULT post_b3_early b_fall_to_allow_count_ps $&r
end
let b_rise_to_tick_n_fall=-1
meas tran b_rise_to_tick_n_fall trig v(p_b) val=1.65 rise=1 td=900n targ v(p_tick_n) val=1.65 fall=1
if b_rise_to_tick_n_fall < 0
echo RESULT post_b3_early b_rise_to_tick_n_fall_ps not_measured
else
let r=b_rise_to_tick_n_fall*1e12
echo RESULT post_b3_early b_rise_to_tick_n_fall_ps $&r
end
let tick_w=-1
meas tran tick_w trig v(p_tick_n) val=1.65 fall=1 targ v(p_tick_n) val=1.65 rise=1
if tick_w < 0
echo RESULT post_b3_early count_pulse_width_ns not_measured
else
let r=tick_w*1e9
echo RESULT post_b3_early count_pulse_width_ns $&r
end
let tick_n_to_n0=-1
meas tran tick_n_to_n0 trig v(p_tick_n) val=1.65 fall=1 targ v(p_n0) val=1.65 rise=1
if tick_n_to_n0 < 0
echo RESULT post_b3_early tick_n_to_n0_ps not_measured
else
let r=tick_n_to_n0*1e12
echo RESULT post_b3_early tick_n_to_n0_ps $&r
end
let n0_to_n1_through_inverter=-1
meas tran n0_to_n1_through_inverter trig v(p_n0) val=1.65 rise=1 targ v(p_n1) val=1.65 rise=1
if n0_to_n1_through_inverter < 0
echo RESULT post_b3_early n0_to_n1_through_inverter_ps not_measured
else
let r=n0_to_n1_through_inverter*1e12
echo RESULT post_b3_early n0_to_n1_through_inverter_ps $&r
end
let stage_n1_fall_to_n2_rise=-1
meas tran stage_n1_fall_to_n2_rise trig v(p_n1) val=1.65 fall=1 targ v(p_n2) val=1.65 rise=1
if stage_n1_fall_to_n2_rise < 0
echo RESULT post_b3_early stage_n1_fall_to_n2_rise_ps not_measured
else
let r=stage_n1_fall_to_n2_rise*1e12
echo RESULT post_b3_early stage_n1_fall_to_n2_rise_ps $&r
end
wrdata tb_chip_post_b3_early.dat v(clk) v(uio_out_4) v(uio_out_5) v(uio_out_1) v(uo_out_0) v(uo_out_1) v(uo_out_2) v(uo_out_3) v(uo_out_4) v(uo_out_5) v(uo_out_6) v(uo_out_7) v(p_capture_local) v(p_early_clk) v(p_selected_q) v(p_bank_selected_q) v(p_bank_obs_clk) v(p_bank_early_q) v(p_bank_cap) v(p_b) v(p_allow_count) v(p_tick_n) v(p_run) v(p_n0) v(p_n1) v(p_n2) v(p_n3)
.endc
.end
