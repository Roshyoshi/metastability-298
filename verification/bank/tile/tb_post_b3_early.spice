Ep_n3 p_n3 0 xdut.gf180mcu_fd_sc_mcu7t5v0__inv_1_32/i 0 1
.options klu
.options rshunt=1e12
.control
set filetype=ascii
set num_threads=1
tran 10p 1600n
let first_cap=-1
meas tran first_cap when v(uio_out_4)=1.65 rise=1
if first_cap < 0
echo RESULT post_b3_early first_capture_ns not_measured
else
let r=first_cap*1e9
echo RESULT post_b3_early first_capture_ns $&r
end
let d1=-1
meas tran d1 trig v(uio_out_4) val=1.65 rise=1 targ v(uio_out_5) val=1.65 rise=1
if d1 < 0
echo RESULT post_b3_early monitor_delay_ps_trial1 not_measured
else
let r=d1*1e12
echo RESULT post_b3_early monitor_delay_ps_trial1 $&r
end
let d2=-1
meas tran d2 trig v(uio_out_4) val=1.65 rise=2 targ v(uio_out_5) val=1.65 rise=2
if d2 < 0
echo RESULT post_b3_early monitor_delay_ps_trial2 not_measured
else
let r=d2*1e12
echo RESULT post_b3_early monitor_delay_ps_trial2 $&r
end
let d3=-1
meas tran d3 trig v(uio_out_4) val=1.65 rise=3 targ v(uio_out_5) val=1.65 rise=3
if d3 < 0
echo RESULT post_b3_early monitor_delay_ps_trial3 not_measured
else
let r=d3*1e12
echo RESULT post_b3_early monitor_delay_ps_trial3 $&r
end
meas tran busy find v(uio_out_1) at=1590n
echo RESULT post_b3_early busy_V $&busy
meas tran done find v(uio_out_2) at=1590n
echo RESULT post_b3_early done_V $&done
meas tran fault find v(uio_out_3) at=1590n
echo RESULT post_b3_early fault_V $&fault
meas tran ev0 find v(uo_out_0) at=1590n
meas tran ev1 find v(uo_out_1) at=1590n
meas tran ev2 find v(uo_out_2) at=1590n
meas tran ev3 find v(uo_out_3) at=1590n
meas tran ev4 find v(uo_out_4) at=1590n
meas tran ev5 find v(uo_out_5) at=1590n
meas tran ev6 find v(uo_out_6) at=1590n
meas tran ev7 find v(uo_out_7) at=1590n
let ev=1*(ev0 gt 1.65)+2*(ev1 gt 1.65)+4*(ev2 gt 1.65)+8*(ev3 gt 1.65)+16*(ev4 gt 1.65)+32*(ev5 gt 1.65)+64*(ev6 gt 1.65)+128*(ev7 gt 1.65)
echo RESULT post_b3_early events $&ev
let d_trial1=-1
meas tran d_trial1 trig v(p_capture_local) val=1.65 rise=1 td=100n targ v(p_early_clk) val=1.65 rise=1 td=100n
if d_trial1 < 0
echo RESULT post_b3_early d_trial1_ps not_measured
else
let r=d_trial1*1e12
echo RESULT post_b3_early d_trial1_ps $&r
end
let d_trial2=-1
meas tran d_trial2 trig v(p_capture_local) val=1.65 rise=1 td=300n targ v(p_early_clk) val=1.65 rise=1 td=300n
if d_trial2 < 0
echo RESULT post_b3_early d_trial2_ps not_measured
else
let r=d_trial2*1e12
echo RESULT post_b3_early d_trial2_ps $&r
end
let d_trial3=-1
meas tran d_trial3 trig v(p_capture_local) val=1.65 rise=1 td=500n targ v(p_early_clk) val=1.65 rise=1 td=500n
if d_trial3 < 0
echo RESULT post_b3_early d_trial3_ps not_measured
else
let r=d_trial3*1e12
echo RESULT post_b3_early d_trial3_ps $&r
end
let bank_cap_after_capture_local_trial1=-1
meas tran bank_cap_after_capture_local_trial1 trig v(p_capture_local) val=1.65 rise=1 td=100n targ v(p_bank_cap) val=1.65 rise=1 td=100n
if bank_cap_after_capture_local_trial1 < 0
echo RESULT post_b3_early bank_cap_after_capture_local_trial1_ps not_measured
else
let r=bank_cap_after_capture_local_trial1*1e12
echo RESULT post_b3_early bank_cap_after_capture_local_trial1_ps $&r
end
let bank_cap_after_capture_local_trial2=-1
meas tran bank_cap_after_capture_local_trial2 trig v(p_capture_local) val=1.65 rise=1 td=300n targ v(p_bank_cap) val=1.65 rise=1 td=300n
if bank_cap_after_capture_local_trial2 < 0
echo RESULT post_b3_early bank_cap_after_capture_local_trial2_ps not_measured
else
let r=bank_cap_after_capture_local_trial2*1e12
echo RESULT post_b3_early bank_cap_after_capture_local_trial2_ps $&r
end
let bank_cap_after_capture_local_trial3=-1
meas tran bank_cap_after_capture_local_trial3 trig v(p_capture_local) val=1.65 rise=1 td=500n targ v(p_bank_cap) val=1.65 rise=1 td=500n
